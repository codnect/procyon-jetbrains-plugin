<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- It cannot be changed between the plugin versions. -->
    <id>io.codnect.procyon.procyon-jetbrains-plugin</id>

    <name>Procyon</name>

    <vendor>Codnect</vendor>

    <description><![CDATA[
        <p>
            IDE support for <b>Procyon</b>, the Go application framework: components, dependency injection,
            HTTP controllers and externalized configuration.
        </p>

        <h3>New project</h3>
        <ul>
            <li>Create a Procyon application from <b>File | New | Project</b>. The plugin installs the Procyon
                CLI and runs <code>procyon init</code> for you, with the HTTP or the CLI runner sample.</li>
        </ul>

        <h3>Components and dependency injection</h3>
        <ul>
            <li>Gutter icons on every component, on its constructor and on its
                <code>component.Register</code> call, with navigation between them.</li>
            <li><b>Could not inject</b>: a parameter of a registered constructor has no component of its type,
                or the name of its qualifier matches none. The components that Procyon registers itself, such as
                <code>runtime.Environment</code>, are known.</li>
            <li><b>Ambiguous injection</b>: more than one component could fill a parameter and no qualifier
                (<code>WithQualifierAt</code>, <code>WithQualifierFor</code>) chooses one.</li>
            <li><b>Duplicate component name</b>: two registrations share a name, which makes Procyon panic at
                startup. <code>component.WithName</code> gives another name.</li>
            <li><b>Constructor called in component.Register</b>, with a quick fix.</li>
            <li>Navigate from a qualifier name to the component that has it.</li>
        </ul>

        <h3>HTTP</h3>
        <ul>
            <li>Gutter icons on controllers and on their handlers, with the routes they serve.</li>
            <li>The <b>Procyon Endpoints</b> tool window lists every endpoint as <code>Controller#handler</code>.</li>
        </ul>

        <h3>Configuration</h3>
        <ul>
            <li>Navigate between a <code>property:"name"</code> tag or a <code>Prefix()</code> of a properties
                struct and its key in the YAML files under <code>resources</code>, and back.</li>
            <li>Completion of property keys in YAML files, like Spring does for <code>application.yml</code>:
                full names, types, defaults and the comments of the fields, also from libraries.</li>
        </ul>

        <p>Requires the Go plugin (GoLand, or IntelliJ IDEA Ultimate with the Go plugin).</p>
    ]]></description>

    <depends>org.jetbrains.plugins.go</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Components -->
        <codeInsight.lineMarkerProvider language="go" implementationClass="io.codnect.procyon.component.ComponentLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="go" implementationClass="io.codnect.procyon.component.RegisterLineMarkerProvider"/>
        <psi.referenceContributor language="go" implementation="io.codnect.procyon.component.QualifierReferenceContributor"/>
        <localInspection language="go" bundle="messages.ProcyonBundle" groupKey="inspection.group.name"
                         key="inspection.could.not.inject.name" shortName="ProcyonCouldNotInject"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="io.codnect.procyon.component.CouldNotInjectInspection"/>
        <localInspection language="go" bundle="messages.ProcyonBundle" groupKey="inspection.group.name"
                         key="inspection.ambiguous.injection.name" shortName="ProcyonAmbiguousInjection"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="io.codnect.procyon.component.AmbiguousInjectionInspection"/>
        <localInspection language="go" bundle="messages.ProcyonBundle" groupKey="inspection.group.name"
                         key="inspection.duplicate.component.name" shortName="ProcyonDuplicateComponent"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="io.codnect.procyon.component.DuplicateComponentInspection"/>
        <localInspection language="go" bundle="messages.ProcyonBundle" groupKey="inspection.group.name"
                         key="inspection.register.call.name" shortName="ProcyonRegisterCall"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="io.codnect.procyon.component.RegisterCallInspection"/>
        <localInspection language="go" bundle="messages.ProcyonBundle" groupKey="inspection.group.name"
                         key="inspection.not.registered.name" shortName="ProcyonNotRegistered"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="io.codnect.procyon.component.NotRegisteredInspection"/>

        <!-- Configuration -->
        <codeInsight.lineMarkerProvider language="go" implementationClass="io.codnect.procyon.config.PropertyLineMarkerProvider"/>
        <psi.referenceContributor language="go" implementation="io.codnect.procyon.config.PropertyReferenceContributor"/>
        <gotoDeclarationHandler implementation="io.codnect.procyon.config.PropertyGotoDeclarationHandler"/>
        <completion.contributor language="yaml" order="first" implementationClass="io.codnect.procyon.config.YamlPropertyCompletionContributor"/>
    </extensions>
</idea-plugin>
